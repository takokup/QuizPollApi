{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=quizpoll;Username=quizpoll;Password=quizpoll_dev",
    "PostgresRead": "",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Database": {
    "AutoCreate": true
  },
  "Jwt": {
    "Key": "DEV-ONLY-change-this-jwt-signing-key-at-least-32-bytes",
    "Issuer": "QuizPollApi",
    "Audience": "QuizPollApi",
    "ExpiryMinutes": 120
  },
  "Security": {
    "HmacKey": "DEV-ONLY-change-this-hmac-key-at-least-32-bytes!!",
    "CacheEncryptionKey": "",
    "TrustForwardedHeaders": false,
    "SessionTokenMaxAgeHours": 24
  },
  "Captcha": {
    "Enabled": false,
    "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify",
    "Secret": ""
  },
  "RateLimiting": {
    "GlobalPerIpPerMinute": 300,
    "AuthPerIpPerMinute": 10,
    "StartPerIpPerMinute": 60,
    "SubmitPerIpPerMinute": 20,
    "SubmitPerUserPerMinute": 20,
    "HubJoinPerIpPerMinute": 60
  },
  "Export": {
    "MaxRows": 50000
  }
}
